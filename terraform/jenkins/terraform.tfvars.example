# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

proxmox_endpoint  = "https://192.168.2.2:8006/"
proxmox_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

proxmox_node          = "proxmoxone"
proxmox_node_ssh_host = "192.168.2.2"

# Defaults: VMID 109, 192.168.2.7/24, hostname jenkins, 2 cores, 4 GB, 20 GB.
# vm_id        = 109
# hostname     = "jenkins"
# ipv4_address = "192.168.2.7/24"

ssh_public_keys = [
  "ssh-ed25519 AAAA... you@laptop",
]
