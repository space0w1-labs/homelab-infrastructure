[Unit]
Description=GitHub Actions ephemeral runner (one job per registration)
Wants=network-online.target
After=network-online.target docker.service

[Service]
ExecStart=/usr/local/sbin/github-runner-ephemeral
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
